---
import ArticleCard from "../components/ArticleCard.astro";
import PillarTile from "../components/PillarTile.astro";
import RelatedContent from "../components/RelatedContent.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { clusters, pillars } from "../data/authority";
import { site } from "../data/site";
import {
  featuredClusters,
  mediaCatalog,
  mediaForCluster,
  mediaForPillar,
} from "../lib/media";
import { homePageGraph, serializeJsonLd } from "../lib/seo/schema";
import OptimizedImage from "../components/OptimizedImage.astro";

const featured = featuredClusters();
---

<BaseLayout>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(homePageGraph())}
  />
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="kicker">{site.heroEyebrow}</p>
        <h1 id="hero-title">
          Yalova'da
          <em>medikal estetik</em>
          ve bütüncül sağlık
        </h1>
        <p class="lede">{site.description}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/rehberler/">Rehberleri incele</a>
          <a class="btn btn--ghost" href="/yazilar/">Yazılara geç</a>
        </div>
      </div>
      <div class="hero__media">
        <OptimizedImage
          media={mediaCatalog.hero}
          priority
          class="hero-media__image"
          sizes="(max-width: 900px) 100vw, 50vw"
        />
      </div>
    </section>

    <section class="scope-strip" data-reveal="fade" aria-label="Rehber kapsamı">
      <div class="container scope-strip__grid">
        <div>
          <p class="scope-strip__value" data-count={pillars.length}>{pillars.length}</p>
          <p class="scope-strip__label">Ana rehber</p>
        </div>
        <div>
          <p class="scope-strip__value" data-count={clusters.length}>{clusters.length}</p>
          <p class="scope-strip__label">Alt konu yazısı</p>
        </div>
        <div>
          <p class="scope-strip__value" data-count={featured.length}>{featured.length}</p>
          <p class="scope-strip__label">Öne çıkan yazı</p>
        </div>
      </div>
    </section>

    <section id="rehberler" class="posts-section guides-section" data-reveal>
      <div class="container">
        <p class="kicker">Dört ana kaynak</p>
        <h2>Kapsamlı sağlık rehberleri</h2>
        <p class="section-intro">
          Medikal estetik, bütüncül sağlık, GETAT ve Yalova sağlık
          olanaklarını bilimsel sınırlar içinde ele alan ana metinler.
        </p>
        <ol class="pillar-tile-grid">
          {
            pillars.map((pillar, index) => (
              <li>
                <PillarTile
                  href={`/rehberler/${pillar.slug}/`}
                  title={pillar.title}
                  description={pillar.description}
                  index={index}
                  media={mediaForPillar(pillar.slug)}
                  count={pillar.clusterSlugs.length}
                  priority={index < 2}
                />
              </li>
            ))
          }
        </ol>
        <a class="more-link" href="/rehberler/">
          Tüm rehberleri ve alt konu yazılarını görün →
        </a>
      </div>
    </section>

    <section id="alt-konular" class="posts-section" data-reveal>
      <div id="yazilar" class="container">
        <p class="kicker">Derinleştirilmiş yazılar</p>
        <h2>Seçilmiş alt konu yazıları</h2>
        <p class="section-intro">
          Her ana rehberden iki örnek; tüm küme yazıları yazılar dizinindedir.
        </p>
        <div class="visual-card-grid">
          {
            featured.map((cluster, index) => (
              <ArticleCard
                href={`/yazilar/${cluster.slug}/`}
                title={cluster.title}
                description={cluster.description}
                category={cluster.category}
                media={mediaForCluster(cluster)}
                date={cluster.lastUpdated}
                priority={index < 2}
              />
            ))
          }
        </div>
        <a class="more-link" href="/yazilar/">
          {clusters.length} yazının tamamını görün →
        </a>
      </div>
    </section>
    <RelatedContent
      currentPath="/"
      keywords={["bütüncül sağlık", "medikal estetik", "GETAT", "sağlık turizmi"]}
    />
  </main>
</BaseLayout>
