---
import ArticleCard from "../../components/ArticleCard.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import { clusters, getPillar } from "../../data/authority";
import type { ClusterContent } from "../../data/authority/types";
import { clinicLinks } from "../../data/links";
import { articleToClinic, clusterTwins } from "../../lib/seo/internal-links";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { mediaForCluster, mediaForPath } from "../../lib/media";
import { formatDateTr, guideWordCount, readingMinutes } from "../../lib/reading";
import { createRelatedContentLinker } from "../../lib/related-content";
import { articlePageGraph, serializeJsonLd } from "../../lib/seo/schema";

export function getStaticPaths() {
  return clusters.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: ClusterContent;
}

const { post } = Astro.props;
const clusterPost = post;
const categoryLabels = {
  estetik: site.labels.aesthetic,
  "butuncul-saglik": site.labels.holistic,
  getat: "Geleneksel ve Tamamlayıcı Tıp",
  "yalova-saglik": "Yalova Sağlık",
};
const categoryLabel = categoryLabels[post.category];
const clinicLinkSource =
  (clinicLinks[post.slug] as { url: string; anchor: string } | undefined) ??
  (articleToClinic[post.slug] as { url: string; title: string } | undefined);
const clinicLink = clinicLinkSource
  ? {
      url: clinicLinkSource.url,
      label:
        "anchor" in clinicLinkSource
          ? clinicLinkSource.anchor
          : clinicLinkSource.title,
    }
  : undefined;
const pillar = getPillar(clusterPost.pillarSlug);
if (!pillar) {
  throw new Error(`Pillar missing for ${post.slug}`);
}
const crumbs = [
  { name: "Ana Sayfa", path: "/" },
  { name: "Yazılar", path: "/yazilar/" },
  { name: post.title, path: `/yazilar/${post.slug}/` },
];
const wordCount = guideWordCount(clusterPost);
const minutes = readingMinutes(wordCount);
const relatedClusters = clusters
  .filter(
    (cluster) =>
      cluster.pillarSlug === clusterPost.pillarSlug &&
      cluster.slug !== clusterPost.slug,
  )
  .slice(0, 4);
const linkRelatedTerms = createRelatedContentLinker(`/yazilar/${post.slug}/`);
const pageMedia = mediaForPath(`/yazilar/${post.slug}/`);
const articleSchema = articlePageGraph({
  post,
  kind: "cluster",
});
const lastUpdatedLabel = formatDateTr(clusterPost.lastUpdated);
const twin = clusterTwins[post.slug];
---

<BaseLayout
  title={post.title}
  description={post.description}
  ogType="article"
  datePublished={clusterPost.lastUpdated}
  dateModified={clusterPost.lastUpdated}
  section={categoryLabel}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(articleSchema)}
  />
  <main>
    <header class="page-hero">
      <div class="page-hero__copy">
        <Breadcrumb items={crumbs} />
        <p
          class:list={[
            "kicker",
            post.category === "estetik" && "badge--aesthetic",
          ]}
        >
          {categoryLabel}
        </p>
        <h1>{post.title}</h1>
        <p>{post.description}</p>
        <div class="byline">
          <span>{site.authorName}</span>
          <time datetime={clusterPost.lastUpdated}>{lastUpdatedLabel}</time>
          <span>{minutes} dakikalık okuma</span>
        </div>
      </div>
      {
        pageMedia[0] && (
          <div class="page-hero__media">
            <OptimizedImage
              media={pageMedia[0]}
              priority
              sizes="(max-width: 900px) 100vw, 50vw"
            />
          </div>
        )
      }
    </header>

    <div class="guide-shell">
          <aside class="guide-toc" aria-label="İçindekiler">
            <strong>İçindekiler</strong>
            <ol>
              {clusterPost.sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>{section.title}</a>
                </li>
              ))}
              <li>
                <a href="#kaynaklar">Bilimsel ve resmî kaynaklar</a>
              </li>
              <li>
                <a href="#sik-sorulan-sorular">Sık sorulan sorular</a>
              </li>
            </ol>
          </aside>

          <article class="guide-content">
            <p class="article-note">
              Bu içerik {site.authorName} tarafından hazırlanmıştır. Ana
              rehber:{" "}
              <a href={`/rehberler/${pillar.slug}/`}>{pillar.title}</a>
            </p>

            {clusterPost.introduction.map((paragraph, index) => (
              <p class={index === 0 ? "lede-graf" : undefined}>
                {linkRelatedTerms(paragraph).map((segment) =>
                  segment.href ? (
                    <a href={segment.href}>{segment.text}</a>
                  ) : (
                    segment.text
                  ),
                )}
              </p>
            ))}

            {clusterPost.sections.map((section) => (
              <section id={section.id} aria-labelledby={`${section.id}-title`}>
                <h2 id={`${section.id}-title`}>{section.title}</h2>
                {section.paragraphs.map((paragraph) => (
                  <p>
                    {linkRelatedTerms(paragraph).map((segment) =>
                      segment.href ? (
                        <a href={segment.href}>{segment.text}</a>
                      ) : (
                        segment.text
                      ),
                    )}
                  </p>
                ))}
                {section.bullets && (
                  <ul>
                    {section.bullets.map((bullet) => (
                      <li>
                        {linkRelatedTerms(bullet).map((segment) =>
                          segment.href ? (
                            <a href={segment.href}>{segment.text}</a>
                          ) : (
                            segment.text
                          ),
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))}

            {
              twin && (
                <aside class="cross-site-cta">
                  <p>
                    {twin.kind === "local"
                      ? "Yalova'da yer arayanlar için yerel rehber:"
                      : "Konunun bilimsel çerçevesi:"}
                  </p>
                  <a href={`/yazilar/${twin.slug}/`}>{twin.title} →</a>
                </aside>
              )
            }

            <section id="ilgili-yazilar" aria-labelledby="ilgili-yazilar-title">
              <h2 id="ilgili-yazilar-title">Aynı Konudaki Diğer Yazılar</h2>
              <div class="visual-card-grid">
                {relatedClusters.map((related) => (
                  <ArticleCard
                    href={`/yazilar/${related.slug}/`}
                    title={related.title}
                    description={related.description}
                    category={related.category}
                    media={mediaForCluster(related)}
                    date={related.lastUpdated}
                  />
                ))}
              </div>
            </section>

            <section id="kaynaklar" aria-labelledby="kaynaklar-title">
              <h2 id="kaynaklar-title">Bilimsel ve Resmî Kaynaklar</h2>
              <ul class="sources-list">
                {clusterPost.sources.map((source) => (
                  <li>
                    <a href={source.url}>{source.title}</a> — {source.publisher}
                  </li>
                ))}
              </ul>
            </section>

            <section
              id="sik-sorulan-sorular"
              aria-labelledby="cluster-faq-title"
            >
              <h2 id="cluster-faq-title">Sık Sorulan Sorular</h2>
              <div class="guide-faq">
                {clusterPost.faqs.map((faq) => (
                  <details>
                    <summary>{faq.question}</summary>
                    <p>{faq.answer}</p>
                  </details>
                ))}
              </div>
            </section>

            {clinicLink && (
              <aside class="cross-site-cta">
                <p>{site.clinicCta}</p>
                <a href={clinicLink.url}>
                  {clinicLink.label} →
                </a>
              </aside>
            )}

            <AuthorBox />
          </article>
        </div>
    <RelatedContent
      currentPath={`/yazilar/${post.slug}/`}
      category={
        post.category === "estetik"
          ? "aesthetic"
          : post.category === "getat"
            ? "getat"
            : post.category === "yalova-saglik"
              ? "local"
              : "holistic"
      }
      keywords={clusterPost.keywords ?? [post.title]}
    />
  </main>
</BaseLayout>
