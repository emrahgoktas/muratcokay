---
import { clusters, pillars } from "../../data/authority";
import { site } from "../../data/site";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PillarTile from "../../components/PillarTile.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { mediaForPillar } from "../../lib/media";
import { guidesIndexGraph, serializeJsonLd } from "../../lib/seo/schema";

const description =
  "Yalova'da bütüncül sağlık, medikal estetik, GETAT ve yerel sağlık olanaklarını bilimsel sınırlar içinde anlatan pillar rehberler.";
---

<BaseLayout title="Kapsamlı Sağlık Rehberleri" description={description}>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(guidesIndexGraph())}
  />
  <main>
    <header class="article-header">
      <div class="container">
        <Breadcrumb
          items={[
            { name: "Ana Sayfa", path: "/" },
            { name: "Rehberler", path: "/rehberler/" },
          ]}
        />
        <p class="kicker">Topikal otorite</p>
        <h1>Kapsamlı sağlık rehberleri</h1>
        <p>{description}</p>
        <a class="more-link" href="/harita/">Konu haritasını görün →</a>
      </div>
    </header>

    <section class="posts-section">
      <div class="container">
        <ol class="pillar-tile-grid">
          {
            pillars.map((pillar, index) => (
              <li>
                <PillarTile
                  href={`/rehberler/${pillar.slug}/`}
                  title={pillar.title}
                  description={pillar.description}
                  index={index}
                  media={mediaForPillar(pillar.slug)}
                  count={
                    pillar.clusterSlugs.filter((slug) =>
                      clusters.some((cluster) => cluster.slug === slug),
                    ).length
                  }
                  priority={index < 2}
                />
              </li>
            ))
          }
        </ol>
        <p class="section-intro">
          Tüm içerikler {site.authorName} tarafından hazırlanmıştır. Metinler
          bilgilendirme amaçlıdır; tanı ve kişiye özel plan yerine geçmez.
        </p>
      </div>
    </section>
    <RelatedContent currentPath="/rehberler/" keywords={["bütüncül sağlık", "medikal estetik", "GETAT"]} />
  </main>
</BaseLayout>
