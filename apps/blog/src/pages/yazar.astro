---
import AuthorBox from "../components/AuthorBox.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import RelatedContent from "../components/RelatedContent.astro";
import { doctor } from "@muratcokay/content";

import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { mediaCatalog } from "../lib/media";
import { CLINIC_URL } from "../lib/seo/internal-links";
import { authorPageGraph, serializeJsonLd } from "../lib/seo/schema";

const crumbs = [
  { name: "Ana Sayfa", path: "/" },
  { name: "Yazar", path: "/yazar/" },
];
---

<BaseLayout
  title="Yazar: Uzm. Dr. Yaşar Murat Çokay"
  description="Yalova Medikal Estetik ve Bütüncül Sağlık Rehberi yazar profili. İçerikler genel bilgilendirme amaçlıdır."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(authorPageGraph())}
  />
  <main>
    <header class="page-hero">
      <div class="page-hero__copy">
        <Breadcrumb items={crumbs} />
        <p class="kicker">Yazar</p>
        <h1>{site.authorName}</h1>
        {
          doctor.biographyParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))
        }
        <p>
          Klinik biyografisi:{" "}
          <a href={`${CLINIC_URL}/hakkimda`}>uzmdrmuratcokay.com.tr/hakkimda</a>
        </p>
      </div>
      <div class="page-hero__media">
        <OptimizedImage
          media={mediaCatalog.portrait}
          priority
          sizes="(max-width: 900px) 100vw, 50vw"
        />
      </div>
    </header>
    <div class="container">
      <AuthorBox />
    </div>
    <RelatedContent currentPath="/yazar/" keywords={["yazar", "bütüncül sağlık"]} />
  </main>
</BaseLayout>
