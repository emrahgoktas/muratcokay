---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Sunucu hatası"
  description="Sayfa geçici olarak yüklenemedi. Ana sayfa ve rehberlerden devam edebilirsiniz."
  robots="noindex, follow"
>
  <main class="container page-empty">
    <p class="kicker">500</p>
    <h1>Sayfa şu anda yüklenemedi</h1>
    <p class="lede">
      Geçici bir sunucu sorunu oluştu. Kısa süre sonra yeniden deneyin veya
      aşağıdaki sayfalara geçin.
    </p>
    <nav class="site-nav" aria-label="Önerilen sayfalar">
      <a href="/">{site.navigation.home}</a>
      <a href="/rehberler/">{site.navigation.guides}</a>
      <a href="/yazilar/">{site.navigation.articles}</a>
      <a href="https://uzmdrmuratcokay.com.tr/iletisim">Klinik iletişim</a>
    </nav>
  </main>
</BaseLayout>
