{
  "name": "muratcokay-ecosystem",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:klinik": "pnpm --filter @muratcokay/klinik dev",
    "dev:blog": "pnpm --filter @muratcokay/blog dev",
    "dev:nis": "pnpm --filter @muratcokay/nis dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "start:klinik": "pnpm --filter @muratcokay/klinik start",
    "start:blog": "pnpm --filter @muratcokay/blog start",
    "start:nis": "pnpm --filter @muratcokay/nis start"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
